#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
#include<unordered_map>
using namespace std;


int main() {
    int q;
    cin >> q;
    unordered_map<string,int> Marks;
    for (int i = 0; i < q; i++){
        int a;
        string name;
        cin >> a >> name;
        if (a == 1){
            int m;
            cin >> m;
            Marks[name] = Marks[name] + m;
        }
        else if (a == 2){
            Marks.erase(name);
        }
        else{
            cout << Marks[name] << endl;
        }
    }  
    return 0;
}
